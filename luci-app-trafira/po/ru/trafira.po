msgid "-- Select --"
msgstr "-- Выберите --"

msgid "%d d"
msgstr "%d д"

msgid "%d h"
msgstr "%d ч"

msgid "%d min"
msgstr "%d мин"

msgid "%d of %d online"
msgstr "%d из %d в сети"

msgid "%d s"
msgstr "%d с"

msgid "%s ago"
msgstr "%s назад"

msgid "%s subnet"
msgstr "подсеть %s"

msgid "+ Add JSON outbound"
msgstr "+ Добавить JSON outbound"

msgid "+ Add level"
msgstr "+ Добавить уровень"

msgid "+ Add priority"
msgstr "+ Добавить приоритет"

msgid "+ Add URLTest"
msgstr "+ Добавить URLTest"

msgid "✔ Running"
msgstr "✔ Работает"

msgid "✘ Stopped"
msgstr "✘ Остановлен"

msgid "A copy download is already starting. Wait, then refresh the status."
msgstr "Загрузка копий уже запускается. Подождите и обновите состояние."

msgid "A maximum of eight profiles can be saved."
msgstr "Можно сохранить не более восьми профилей."

msgid "A protective traffic block remains after a failed switch. Restart Trafira to recheck the configuration."
msgstr "После неудачного переключения сохраняется защитная блокировка трафика. Перезапустите Trafira для повторной проверки конфигурации."

msgid "A required saved list is missing or unreadable. Download or update copies in Saved rule sets, then try again."
msgstr "Нужная копия списка отсутствует или не читается. Скачайте или обновите копии в блоке «Копии списков для запуска» и повторите проверку."

msgid "A saved list changed during the check. Try again."
msgstr "Во время проверки изменилась копия списка. Повторите проверку."

msgid "Absolute path to an existing file on the router. Enter the path, not the file contents."
msgstr "Абсолютный путь к существующему файлу на роутере. Введите путь, а не содержимое файла."

msgid "Accept external proxy connections and route them with sing-box."
msgstr "Принимает внешние прокси-подключения и маршрутизирует их через sing-box."

msgid "Accept routes"
msgstr "Принимать маршруты"

msgid "Action"
msgstr "Действие"

msgid "Active"
msgstr "Активные"

msgid "Active Bootstrap DNS"
msgstr "Активный Bootstrap DNS"

msgid "Active Connections"
msgstr "Активные соединения"

msgid "Active Main DNS"
msgstr "Активный основной DNS"

msgid "Add %s to Source Network Interface first"
msgstr "Сначала добавьте %s в «Сетевой интерфейс источника»"

msgid "Add a section"
msgstr "Добавить секцию"

msgid "Add a server inbound"
msgstr "Добавить серверный inbound"

msgid "Add an interface to match all its clients, such as every peer on a WireGuard server. It must also be selected in Source Network Interface."
msgstr "Добавьте интерфейс, чтобы включить в список всех его клиентов, например всех пиров WireGuard. Он также должен быть выбран в поле «Сетевой интерфейс источника»."

msgid "Add at least one DNS server"
msgstr "Добавьте хотя бы один DNS-сервер"

msgid "Add IPv4 and IPv6 addresses or subnets as separate entries. For LAN or Wi-Fi devices, use a MAC address if the IP may change. IP addresses can be spoofed."
msgstr "Добавляйте адреса и подсети IPv4 и IPv6 отдельными записями. Если IP-адрес устройства в LAN или Wi-Fi может измениться, укажите его MAC-адрес. IP-адрес можно подменить."

msgid "Add prefix to nodes"
msgstr "Добавлять префикс к узлам"

msgid "Add URLs or local paths to .lst lists containing domains and subnets."
msgstr "Добавьте URL или локальные пути к спискам .lst с доменами и подсетями."

msgid "Add URLs or local paths to .lst lists containing domains. IP entries are ignored."
msgstr "Добавьте URL или локальные пути к спискам .lst с доменами. IP игнорируются."

msgid "Add URLs or local paths to .srs / .json lists. Only domain rules are supported."
msgstr "Добавьте URL или локальные пути к спискам .srs / .json. Поддерживаются только доменные правила."

msgid "Add URLs or local paths to .srs / .json lists. Subnets are ignored by default."
msgstr "Добавьте URL или локальные пути к спискам .srs / .json. Подсети по умолчанию игнорируются."

msgid "Add URLTest / Priority group"
msgstr "Добавить URLTest / Приоритет группу"

msgid "Added"
msgstr "Добавлено"

msgid "Additional marking rules found"
msgstr "Найдены дополнительные правила маркировки"

msgid "Additional route information (optional)"
msgstr "Дополнительные сведения о маршруте (необязательно)"

msgid "Additionally exclude servers by protocol, transport, and security. Exclude only servers matching the specified parameters."
msgstr "Дополнительно исключать серверы по протоколу, транспорту и защите. Исключать только серверы, совпавшие по указанным параметрам."

msgid "Additionally filter servers by protocol, transport, and security. Add only servers matching the specified parameters."
msgstr "Дополнительно отбирать серверы по протоколу, транспорту и защите. Добавлять только серверы, совпавшие по указанным параметрам."

msgid "Additionally hide servers by protocol, transport, and security. Hide servers matching the specified parameters."
msgstr "Дополнительно скрывать серверы по протоколу, транспорту и защите. Скрывать серверы, совпавшие по указанным параметрам."

msgid "Additionally show servers by protocol, transport, and security. Add only servers matching the specified parameters."
msgstr "Дополнительно показывать серверы по протоколу, транспорту и защите. Добавлять только серверы, совпавшие по указанным параметрам."

msgid "Address"
msgstr "Адрес"

msgid "Advertise exit node"
msgstr "Анонсировать exit node"

msgid "Advertise routes"
msgstr "Анонсировать маршруты"

msgid "After a connection failure, retry the skipped server after this duration"
msgstr "После ошибки соединения повторять попытку через этот интервал"

msgid "After existing device rules"
msgstr "После существующих правил устройств"

msgid "Alice Mode"
msgstr "Alice Mode"

msgid "Alice Mode bypasses this device. Explicitly enable its selected addresses before applying."
msgstr "Alice Mode исключает это устройство. Перед применением явно включите обработку выбранных адресов."

msgid "Alice Mode devices are currently unavailable"
msgstr "Данные об устройствах Alice Mode временно недоступны"

msgid "Alice Mode needs this device MAC or incoming interface. Select a detected device, or enter the missing details."
msgstr "Для Alice Mode нужны MAC-адрес или входящий интерфейс устройства. Выберите обнаруженное устройство или укажите недостающие сведения."

msgid "Alice Mode sends this device directly, bypassing Trafira."
msgstr "Alice Mode направляет это устройство напрямую, в обход Trafira."

msgid "All"
msgstr "Все"

msgid "All except selected"
msgstr "Все, кроме выбранных"

msgid "All remaining except selected"
msgstr "Все оставшиеся, кроме выбранных"

msgid "All remaining servers"
msgstr "Все оставшиеся серверы"

msgid "All remaining servers means every server not already assigned to a higher-priority level."
msgstr "Добавляет все серверы, которые не попали в уровни с более высоким приоритетом."

msgid "All servers"
msgstr "Все серверы"

msgid "All traffic from these IP addresses will be routed through the section unconditionally, ignoring all other conditions."
msgstr "Весь трафик с этих IP-адресов будет направлен через секцию безусловно, игнорируя остальные условия."

msgid "Allow direct fallback without VPN"
msgstr "Разрешить прямой выход без VPN"

msgid "Allowed domain prefixes are full:, keyword:, and regex:"
msgstr "Разрешённые префиксы доменов: full:, keyword: и regex:"

msgid "Allows access to YACD from the WAN. Make sure to open the appropriate port in your firewall."
msgstr "Обеспечивает доступ к YACD из WAN. Убедитесь, что в брандмауэре открыт соответствующий порт."

msgid "Allows limiting the list of servers for URLTest"
msgstr "Позволяет ограничить список серверов для URLTest"

msgid "ALPN"
msgstr "ALPN"

msgid "Alter ID"
msgstr "Alter ID"

msgid "An earlier rule checks destination addresses. Enter the real destination IP in Additional route information."
msgstr "Более раннее правило проверяет IP назначения. Укажите реальный IP в дополнительных сведениях."

msgid "An earlier rule checks the application protocol. Select the protocol to continue."
msgstr "Более раннее правило проверяет протокол приложения. Выберите протокол для продолжения."

msgid "An earlier rule needs additional data. See the rule evaluation details below."
msgstr "Для более раннего правила нужны дополнительные данные. Подробнее — в порядке проверки правил ниже."

msgid "An earlier rule uses a condition this diagnostic cannot evaluate. The route cannot be confirmed."
msgstr "Более раннее правило использует условие, которое эта проверка не рассчитывает. Подтвердить маршрут нельзя."

msgid "An existing device rule may overlap. The selected priority determines which rule takes effect."
msgstr "Правила устройства могут пересекаться. Выбранный приоритет определяет, какое правило сработает первым."

msgid "Analysis of the applied configuration, not a live connection capture."
msgstr "Анализ применённой конфигурации. Фактическое соединение может зависеть от дополнительных условий."

msgid "Another configuration operation is already running."
msgstr "Уже выполняется другая операция с конфигурацией."

msgid "Another list update is already running. Wait for it to finish, then download the copies again."
msgstr "Списки уже обновляются. Дождитесь завершения и повторите загрузку копий."

msgid "Apply profile"
msgstr "Применить профиль"

msgid "Apply reviewed changes"
msgstr "Применить просмотренные изменения"

msgid "Apply section rules only to the specified local IP addresses"
msgstr "Применять правила секции только к указанным локальным IP-адресам"

msgid "Apply the Trafira configuration again to enable saved copies for this core"
msgstr "Повторно примените конфигурацию Trafira, чтобы включить сохранение копий для этого ядра"

msgid "Applying configuration. You can reconnect to this page."
msgstr "Применение конфигурации. Можно закрыть страницу и вернуться позднее."

msgid "Applying settings in the background. You can close this page."
msgstr "Настройки применяются в фоне. Эту страницу можно закрыть."

msgid "Applying these settings replaces the saved configuration. Any unsaved changes in this LuCI page will be lost. Continue?"
msgstr "Применение заменит сохранённые настройки. Несохранённые изменения в открытой странице LuCI будут потеряны. Продолжить?"

msgid "At least one valid domain must be specified."
msgstr "Нужно указать хотя бы один корректный домен."

msgid "At least one valid IP or subnet must be specified."
msgstr "Нужно указать хотя бы один корректный IP-адрес или подсеть."

msgid "Auto refresh"
msgstr "Автообновление"

msgid "Auto update"
msgstr "Автообновление"

msgid "Auto-generate HWID"
msgstr "Авто-генерация HWID"

msgid "Automatic component update checks"
msgstr "Автоматическая проверка обновлений компонентов"

msgid "Automatic User-Agent selection"
msgstr "Авто-подбор User-Agent"

msgid "Automatically add text to the name of each server from this subscription for convenient filtering."
msgstr "Автоматически добавлять текст к имени каждого сервера из этой подписки для удобной фильтрации."

msgid "Automatically check installed components for new versions"
msgstr "Автоматически проверять наличие новых версий установленных компонентов"

msgid "Automatically select the fastest node in the current level"
msgstr "Автовыбор самого быстрого узла уровня"

msgid "Availability check error"
msgstr "Ошибка проверки доступности"

msgid "Available actions"
msgstr "Доступные действия"

msgid "Backend validation failed: %s"
msgstr "Backend-проверка завершилась ошибкой: %s"

msgid "Before existing device rules"
msgstr "Перед существующими правилами устройств"

msgid "Block connection"
msgstr "Заблокировать соединение"

msgid "Block traffic"
msgstr "Блокировать трафик"

msgid "Blocked"
msgstr "Заблокировано"

msgid "Bootstrap DNS"
msgstr "Bootstrap DNS"

msgid "Bootstrap DNS Servers"
msgstr "Bootstrap DNS-серверы"

msgid "Browser FakeIP check could not be completed"
msgstr "Не удалось выполнить проверку FakeIP в браузере"

msgid "Browser is not using FakeIP"
msgstr "Браузер не использует FakeIP"

msgid "Browser is using FakeIP correctly"
msgstr "Браузер использует FakeIP"

msgid "Built-in rule sets"
msgstr "Встроенные наборы правил"

msgid "By flag emoji from name"
msgstr "По эмодзи флага из названия"

msgid "ByeDPI listen address and port are assigned by Trafira and must not be set in the strategy."
msgstr "Адрес и порт прослушивания ByeDPI назначаются Trafira и не должны задаваться в стратегии."

msgid "ByeDPI option does not accept a compact value: %s"
msgstr "Опция ByeDPI не принимает компактное значение: %s"

msgid "ByeDPI option does not accept a value: %s"
msgstr "Опция ByeDPI не принимает значение: %s"

msgid "ByeDPI option requires a value: %s"
msgstr "Для опции ByeDPI требуется значение: %s"

msgid "ByeDPI package is installed"
msgstr "Пакет ByeDPI установлен"

msgid "ByeDPI package is not installed"
msgstr "Пакет ByeDPI не установлен"

msgid "ByeDPI provider binary is available"
msgstr "Бинарный файл провайдера ByeDPI доступен"

msgid "ByeDPI provider binary is not available"
msgstr "Бинарный файл провайдера ByeDPI недоступен"

msgid "ByeDPI sing-box outbound is configured"
msgstr "Outbound ByeDPI в sing-box настроен"

msgid "ByeDPI sing-box outbound is not configured"
msgstr "Outbound ByeDPI в sing-box не настроен"

msgid "ByeDPI Strategy"
msgstr "Стратегия ByeDPI"

msgid "ByeDPI strategy cannot be empty"
msgstr "Стратегия ByeDPI не может быть пустой"

msgid "Bypass BitTorrent"
msgstr "Торренты напрямую"

msgid "Bypass Trafira"
msgstr "Идут в обход Trafira"

msgid "Bypass Trafira; DNS returns real addresses"
msgstr "В обход Trafira, DNS возвращает реальные адреса"

msgid "Bypass Wi-Fi Calling"
msgstr "Wi-Fi Calling напрямую"

msgid "Cache File Path"
msgstr "Путь к файлу кэша"

msgid "Cache file path cannot be empty"
msgstr "Путь к файлу кэша не может быть пустым"

msgid "Cached servers: %s; included: %s; excluded: %s"
msgstr "Серверов в кеше: %s; остаётся: %s; исключено: %s"

msgid "Calculated using saved list copies. The running sing-box may have newer lists; this is a configuration check, not a live connection test."
msgstr "Расчёт по сохранённым копиям списков. Работающий sing-box мог обновить их. Это проверка конфигурации, а не реального соединения."

msgid "Cannot receive checks result"
msgstr "Не удалось получить результаты проверки"

msgid "Cannot save server"
msgstr "Не удалось сохранить сервер"

msgid "Cannot save settings"
msgstr "Не удалось сохранить настройки"

msgid "Cascade connection"
msgstr "Каскадное подключение"

msgid "Catalog checked"
msgstr "Список проверен"

msgid "Certificate path"
msgstr "Путь к сертификату"

msgid "Certificate pin is unavailable. Apply or restart the server to generate the default certificate, then open this dialog again."
msgstr "Пин сертификата недоступен. Примените или перезапустите сервер, чтобы сгенерировать дефолтный сертификат, затем откройте это окно снова."

msgid "Changed"
msgstr "Изменено"

msgid "Changed rules"
msgstr "Изменения правил"

msgid "Check interval"
msgstr "Интервал проверки"

msgid "Check timeout after which the server is considered dead"
msgstr "Таймаут проверки, после которого сервер считается мёртвым"

msgid "Check update"
msgstr "Проверить обновление"

msgid "Check URL"
msgstr "URL проверки"

msgid "Checking route"
msgstr "Проверка маршрута"

msgid "Checking, please wait"
msgstr "Проверяем, пожалуйста подождите"

msgid "checks"
msgstr "проверки"

msgid "Checks failed"
msgstr "Проверки не выполнены"

msgid "Checks passed"
msgstr "Проверки пройдены"

msgid "Checks passed with manual DHCP"
msgstr "Проверки пройдены с ручным DHCP"

msgid "Choose a platform"
msgstr "Выберите платформу"

msgid "Choose a platform, device addresses, connection and rule priority before previewing."
msgstr "Для предпросмотра выберите платформу, IP-адреса устройства, подключение и приоритет правил."

msgid "Choose an available version of the installed variant. Compatibility is checked before replacement. Pinning affects updates through Trafira only."
msgstr "Выберите доступную версию установленного варианта. Перед заменой проверяется совместимость. Закрепление влияет только на обновления через Trafira."

msgid "Choose rule priority"
msgstr "Выберите приоритет правил"

msgid "Choose what happens after confirmed connection failures. Direct fallback sends this section's traffic without its VPN. Switching interrupts existing connections; protection requires Trafira to be running."
msgstr "Выберите действие при подтверждённом отказе подключения. Прямой выход отправляет трафик секции без её VPN. Переключение прерывает текущие соединения; защита действует, пока Trafira работает."

msgid "Choose whether devices in the list use Trafira or bypass it. Bypassed devices connect directly and receive real IP addresses from DNS."
msgstr "Выберите, будут ли устройства из списка идти через Trafira или в обход. Устройства в обход подключаются напрямую и получают от DNS реальные IP-адреса."

msgid "CIDR must be between 0 and 32 for IPv4 or 0 and 128 for IPv6"
msgstr "CIDR должен быть от 0 до 32 для IPv4 или от 0 до 128 для IPv6"

msgid "Client certificate file"
msgstr "Файл клиентского сертификата"

msgid "Client fingerprint"
msgstr "Отпечаток клиента"

msgid "Client link"
msgstr "Ссылка клиента"

msgid "Client link is not available yet"
msgstr "Ссылка клиента пока недоступна"

msgid "Client link QR code"
msgstr "QR-код клиентской ссылки"

msgid "Client private key file"
msgstr "Файл закрытого ключа клиента"

msgid "Close"
msgstr "Закрыть"

msgid "Close all connections"
msgstr "Закрыть все подключения"

msgid "Close connection"
msgstr "Закрыть подключение"

msgid "Closed"
msgstr "Закрытые"

msgid "Component update available"
msgstr "Доступно обновление компонента"

msgid "Component update check interval"
msgstr "Период проверки обновлений"

msgid "Components"
msgstr "Компоненты"

msgid "compressed"
msgstr "compressed"

msgid "Concurrency"
msgstr "Параллелизм"

msgid "Conditions"
msgstr "Условия"

msgid "Config File Path"
msgstr "Путь к файлу конфигурации"

msgid "Configuration changed. Review the differences again."
msgstr "Конфигурация изменилась. Просмотрите различия ещё раз."

msgid "Configuration for Trafira service"
msgstr "Настройки сервиса Trafira"

msgid "Configuration profiles"
msgstr "Профили настроек"

msgid "Configuration validation passed. Review the changes below."
msgstr "Конфигурация прошла проверку. Просмотрите изменения ниже."

msgid "Configure User-Agent in the item settings"
msgstr "Настройте User-Agent в настройках элемента"

msgid "Connect through"
msgstr "Подключаться через"

msgid "Connection options"
msgstr "Параметры соединения"

msgid "Connection route"
msgstr "Маршрут соединения"

msgid "Connection URL"
msgstr "URL подключения"

msgid "Connections are unavailable"
msgstr "Подключения недоступны"

msgid "Connectivity probe failed"
msgstr "Проверка соединения не прошла"

msgid "Consecutive failures before switching"
msgstr "Неудач подряд до переключения"

msgid "Consecutive successes before recovery"
msgstr "Успехов подряд до восстановления"

msgid "Copied"
msgstr "Скопировано"

msgid "Copies are checked when downloaded and before startup. This inventory does not verify their current contents or whether the running service uses them."
msgstr "Копии проверяются при загрузке и перед запуском. Этот список показывает наличие файлов, но не проверяет их содержимое и использование работающим сервисом."

msgid "Copies stored on router"
msgstr "Копий на роутере"

msgid "Copies were downloaded and checked. They will be checked again before the next startup."
msgstr "Копии скачаны и проверены. Перед следующим запуском Trafira проверит их ещё раз."

msgid "Copy"
msgstr "Копировать"

msgid "Copy missing"
msgstr "Копия отсутствует"

msgid "Copy present"
msgstr "Копия сохранена"

msgid "Copy proxy link"
msgstr "Скопировать ссылку прокси"

msgid "Could not compare FakeIP and control public IPs"
msgstr "Не удалось сравнить публичные IP FakeIP и контрольной проверки"

msgid "Could not download copies. Check the internet connection, list-download proxy and router storage."
msgstr "Не удалось скачать копии. Проверьте интернет, прокси для загрузки списков и свободное место на роутере."

msgid "Could not download copies. Check the sing-box version, saved configuration and proxy for list downloads."
msgstr "Не удалось скачать копии. Проверьте версию sing-box, сохранённую конфигурацию и прокси для загрузки списков."

msgid "Could not explain route. Check that Trafira is running, then try again."
msgstr "Не удалось проверить маршрут. Убедитесь, что Trafira работает, и повторите проверку."

msgid "Could not load available versions. Check the connection and refresh the list."
msgstr "Не удалось загрузить доступные версии. Проверьте подключение и обновите список."

msgid "Could not read saved-copy status. Refresh the status to try again."
