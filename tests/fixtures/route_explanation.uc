let m = require("diagnostics.route_match");
let p = require("singbox.provenance");
let checks = 0;
function check(value, message) { checks++; assert(value, message); }
let req = {domain:"store.example",source_ip:"192.0.2.5",port:443,network:"tcp",inbound:"tproxy-in"};
check(m.match_rule({domain_suffix:"example"},req,{}).value == "yes", "suffix");
check(m.match_rule({domain_suffix:"ore.example"},req,{}).value == "no", "suffix boundary");
check(m.match_rule({domain:"STORE.EXAMPLE."},req,{}).value == "yes", "case and dot");
check(m.match_rule({source_ip_cidr:"198.51.100.0/24",domain_suffix:"example"},req,{}).value == "no", "source AND destination");
check(m.match_rule({domain:"other.example",ip_cidr:"203.0.113.0/24"},req,{}).value == "unknown", "missing destination IP");
check(m.match_rule({domain_suffix:"example",ip_cidr:"203.0.113.0/24"},req,{}).value == "yes", "domain OR IP");
check(m.match_rule({port:[80],port_range:["440:450"]},req,{}).value == "yes", "port OR range");
check(m.match_rule({port:80,protocol:"tls"},req,{}).value == "no", "known false defeats unknown AND");
check(m.match_rule({protocol:"tls"},req,{}).value == "unknown", "do not infer TLS from port");
check(m.match_rule({domain_regex:"["},req,{}).value == "unknown", "invalid regex");
check(m.match_rule({domain_regex:"^store[.]example$"},req,{}).value == "yes", "portable regex");
check(m.match_rule({domain_regex:"(?i)^STORE"},req,{}).value == "unknown", "unsupported Go regex flags");
check(m.match_rule({new_future_matcher:true},req,{}).value == "unknown", "future field");
check(m.match_rule({type:"logical",mode:"or",rules:[{port:443},{protocol:"tls"}]},req,{}).value == "yes", "logical OR");
check(m.match_rule({type:"logical",mode:"and",rules:[{port:443},{protocol:"tls"}]},req,{}).value == "unknown", "logical AND");
check(m.match_rule({protocol:"tls",invert:true},req,{}).value == "unknown", "invert unknown");
check(m.match_rule({port:80,invert:true},req,{}).value == "yes", "invert false");
let ipv6 = {source_ip:"2001:db8::5",destination_ip:"2001:db8:1::9",ip_version:6};
check(m.match_rule({source_ip_cidr:"2001:db8::/64",ip_cidr:"2001:db8:1::/64"},ipv6,{}).value == "yes", "IPv6");
check(m.match_rule({rule_set:"missing"},req,{}).value == "unknown", "missing rule set");
let sets = {cached:{version:3,rules:[{domain_suffix:"example"}]},source:{version:3,rules:[{ip_cidr:"192.0.2.0/24"}]}};
check(m.match_rule({rule_set:"cached",source_ip_cidr:"192.0.2.5/32"},req,sets).value == "yes", "cached set");
check(m.match_rule({rule_set:"source",rule_set_ip_cidr_match_source:true},req,sets).value == "yes", "set matches source");
let config = {route:{rules:[{protocol:"bittorrent",action:"route",outbound:"bypass-out"},{domain_suffix:"example",action:"route",outbound:"vpn-out"}],final:"direct-out"}};
check(m.explain(config,req,{},sets).status == "indeterminate", "unknown early terminal rule");
config.route.rules[0] = {port:80,action:"route",outbound:"bypass-out"};
let answer = m.explain(config,req,{},sets);
check(answer.status == "matched" && answer.rule_index == 1 && answer.outbound == "vpn-out", "first matching rule");
config.route.rules[0] = {action:"sniff"};
check(m.explain(config,req,{},sets).status == "matched", "sniff continues");
config.route.rules[0] = {action:"route-options",override_port:80};
config.route.rules[1] = {port:443,action:"route",outbound:"vpn-out"};
check(m.explain(config,req,{},sets).status == "direct", "route options affect later port");
config.route.rules = [{action:"resolve"},{ip_cidr:"203.0.113.0/24",action:"route",outbound:"vpn-out"}];
check(m.explain(config,req,{},sets).status == "indeterminate", "resolve does not invent address");
config.route.rules = [{action:"reject"}];
check(m.explain(config,req,{},sets).status == "blocked", "reject");
config.route.rules = [{action:"new-action"}];
check(m.explain(config,req,{},sets).status == "indeterminate", "unknown action");
let rules = [];
for (let i=0;i<230;i++) push(rules,{domain:"other.example",action:"reject"});
push(rules,{domain:"store.example",action:"route",outbound:"vpn-out"});
config.route.rules = rules;
answer = m.explain(config,req,{},sets);
check(answer.status == "matched" && answer.rule_index == 230 && length(answer.trace) <= 200, "trace limit does not truncate evaluation");
let annotated = {route:{rules:[p.annotate({action:"reject"},{kind:"section",section:"blocked",password:"secret"})]},dns:{rules:[]}};
let origins = p.extract(annotated);
check(origins.route[0].section == "blocked", "provenance");
check(index(sprintf("%J",annotated),"__") < 0, "no internal fields in sing-box JSON");
check(index(sprintf("%J",origins),"secret") < 0, "provenance privacy");
print("route explanation: ",checks," checks passed\n");
