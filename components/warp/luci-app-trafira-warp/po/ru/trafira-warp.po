msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru\n"

msgid "A protected WARP section will be created. Choose sites or devices in Trafira afterwards."
msgstr "Будет создана защищённая секция WARP. Затем выберите сайты или устройства в Trafira."

msgid "Accept and register"
msgstr "Принять условия и зарегистрировать"

msgid "Added"
msgstr "Добавлено"

msgid "After detaching, traffic follows the remaining Trafira rules and default route."
msgstr "После отключения секции трафик будет следовать оставшимся правилам Trafira и маршруту по умолчанию."

msgid "An operation is running. You can close this page; it will continue."
msgstr "Выполняется операция. Можно закрыть страницу — работа продолжится."

msgid "An unfinished operation needs recovery. Retry an action to restore its backup first."
msgstr "Обнаружена незавершённая операция. Повторите действие: сначала будет восстановлена резервная копия."

msgid "Another operation is running. Try again when it finishes."
msgstr "Выполняется другая операция. Дождитесь её завершения."

msgid "Apply candidate"
msgstr "Применить результат"

msgid "Apply reviewed changes"
msgstr "Применить показанные изменения"

msgid "Attach to Trafira"
msgstr "Подключить к Trafira"

msgid "Cancel"
msgstr "Отмена"

msgid "Cancel operation"
msgstr "Отменить операцию"

msgid "Candidate"
msgstr "Результат подбора"

msgid "Changed"
msgstr "Изменено"

msgid "Cloudflare terms of service"
msgstr "Условия использования Cloudflare"

msgid "Confirm"
msgstr "Подтвердить"

msgid "Create a Cloudflare registration, discover an endpoint and start the tunnel. No Trafira routing rules are added until you attach it."
msgstr "Создать регистрацию Cloudflare, подобрать сервер и запустить туннель. Правила маршрутизации Trafira добавляются отдельно через подключение секции."

msgid "Delete local registration"
msgstr "Удалить локальную регистрацию"

msgid "Detach from Trafira"
msgstr "Отключить секцию Trafira"

msgid "Disable"
msgstr "Выключить"

msgid "Disable WARP"
msgstr "Выключение WARP"

msgid "Disabled"
msgstr "Выключен"

msgid "Enable"
msgstr "Включить"

msgid "Endpoint"
msgstr "Сервер подключения"

msgid "Full discovery"
msgstr "Полный подбор"

msgid "HTTP 403/429"
msgstr "Ответов HTTP 403/429"

msgid "Handshake age (seconds)"
msgstr "Давность рукопожатия (секунды)"

msgid "Install the complete WARP component first."
msgstr "Сначала установите полный комплект пакетов WARP."

msgid "Last HTTPS check"
msgstr "Последняя проверка HTTPS"

msgid "Not confirmed"
msgstr "Не подтверждена"

msgid "Not enough storage or private state is unavailable."
msgstr "Недостаточно места или недоступны файлы состояния."

msgid "Not registered"
msgstr "Нет регистрации"

msgid "Operation cancelled; partial test results are retained."
msgstr "Операция отменена; частичные результаты теста сохранены."

msgid "Optional tunnel for selected sites and devices. WARP does not guarantee access to every service or a particular country."
msgstr "Необязательный туннель для выбранных сайтов и устройств. WARP не гарантирует доступ ко всем сервисам или выход через определённую страну."

msgid "Passed"
msgstr "Успешно"

msgid "Present"
msgstr "Есть"

msgid "Quick discovery"
msgstr "Быстрый подбор"

msgid "Reconnect"
msgstr "Переподключить"

msgid "Recovery failed. The backup has been retained."
msgstr "Восстановление не удалось. Резервная копия сохранена."

msgid "Register"
msgstr "Зарегистрировать"

msgid "Register WARP"
msgstr "Регистрация WARP"

msgid "Registration"
msgstr "Регистрация"

msgid "Remove all Trafira references to this WARP interface first."
msgstr "Сначала удалите все ссылки Trafira на этот интерфейс WARP."

msgid "Removed"
msgstr "Удалено"

msgid "Restore the unfinished Trafira operation first."
msgstr "Сначала восстановите незавершённую операцию Trafira."

msgid "Review Trafira changes"
msgstr "Предпросмотр изменений Trafira"

msgid "Running"
msgstr "Работает"

msgid "Samples"
msgstr "Проверок"

msgid "Select and apply an endpoint first."
msgstr "Сначала подберите и примените сервер подключения."

msgid "Service availability test"
msgstr "Проверка доступности сервисов"

msgid "Settings changed. Open a new preview."
msgstr "Настройки изменились. Откройте новый предпросмотр."

msgid "Start WARP and run a successful HTTPS check first."
msgstr "Сначала запустите WARP и выполните успешную проверку HTTPS."

msgid "Stopped; recovery pending"
msgstr "Остановлен; ожидается восстановление"

msgid "Test Google, ChatGPT, Gemini, Grok and Cloudflare"
msgstr "Проверить Google, ChatGPT, Gemini, Grok и Cloudflare"

msgid "The Cloudflare registration API is unavailable."
msgstr "API регистрации Cloudflare недоступен."

msgid "The candidate expired. Run discovery again."
msgstr "Результат подбора устарел. Повторите поиск."

msgid "The operation failed. Check status and retry."
msgstr "Операция не удалась. Проверьте состояние и повторите попытку."

msgid "The tunnel and its local credentials will be removed. Cloudflare-side registration is not revoked. All Trafira references must be removed first."
msgstr "Туннель и его локальные данные регистрации будут удалены. Регистрация на стороне Cloudflare не отзывается. Сначала удалите все ссылки Trafira на этот интерфейс."

msgid "The tunnel did not pass the HTTPS check."
msgstr "Туннель не прошёл проверку HTTPS."

msgid "Traffic assigned to WARP in Trafira will be blocked until the tunnel is enabled again."
msgstr "Трафик, назначенный WARP в Trafira, будет заблокирован до повторного включения туннеля."

msgid "Transport errors"
msgstr "Ошибок соединения"

msgid "Tunnel"
msgstr "Туннель"

msgid "Unknown"
msgstr "Неизвестно"

msgid "WARP for Trafira"
msgstr "WARP для Trafira"

msgid "WARP is unavailable. Check the installed package family."
msgstr "WARP недоступен. Проверьте комплект установленных пакетов."

msgid "minutes"
msgstr "минут"


msgid "Median / p95 (ms)"
msgstr "Медиана / p95 (мс)"

msgid "Automatic recovery paused after three attempts. Check the connection and use Reconnect to retry."
msgstr "Автовосстановление приостановлено после трёх попыток. Проверьте подключение и нажмите «Переподключить», чтобы повторить."

msgid "DNS errors"
msgstr "Ошибки DNS"

msgid "Connection errors"
msgstr "Ошибки соединения"

msgid "HTTP errors"
msgstr "Ошибки HTTP"
