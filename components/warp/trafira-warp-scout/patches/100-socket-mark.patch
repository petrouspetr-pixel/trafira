+++ b/trafira_linux.go
@@ -0,0 +1,45 @@
+//go:build linux
+
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Trafira contributors
+package main
+
+import (
+ "context"
+ "fmt"
+ "net"
+ "net/netip"
+ "strings"
+ "syscall"
+ "time"
+ "golang.org/x/sys/unix"
+)
+
+var trafiraMark uint
+func socketMarkControl(raw syscall.RawConn, mark uint32) error {
+ var operation error
+ if err:=raw.Control(func(fd uintptr){operation=unix.SetsockoptInt(int(fd),unix.SOL_SOCKET,unix.SO_MARK,int(mark))});err!=nil{return err}
+ return operation
+}
+func markedControl(iface string, maxseg int, mark uint32) func(string,string,syscall.RawConn)error {
+ return func(network,address string,raw syscall.RawConn)error {
+  if iface!="" {if err:=deviceControl(iface,maxseg)(network,address,raw);err!=nil{return err}}
+  if mark!=0 {
+   if strings.HasPrefix(network,"tcp") {
+    host,_,err:=net.SplitHostPort(address);if err!=nil{return err}
+    ip,err:=netip.ParseAddr(host);if err!=nil{return err}
+    if !ip.IsGlobalUnicast() || ip.IsPrivate() || ip.IsLoopback() || netip.MustParsePrefix("198.18.0.0/15").Contains(ip) {return fmt.Errorf("non-public API address")}
+   }
+   return socketMarkControl(raw,mark)
+  }
+  return nil
+ }
+}
+func markedResolver() *net.Resolver {
+ if trafiraMark==0 {return net.DefaultResolver}
+ return &net.Resolver{PreferGo:true,Dial:func(ctx context.Context,network,address string)(net.Conn,error){
+  // This dedicated resolver belongs only to the marked registration client.
+  d:=net.Dialer{Timeout:8*time.Second,Control:markedControl("",0,uint32(trafiraMark))}
+  return d.DialContext(ctx,network,"1.1.1.1:53")
+ }}
+}
