let fs=require("fs"),t=require("service.config_transaction"),hash=require("singbox.provenance").hash_file;
let target=getenv("TRAFIRA_CONFIG_FILE"),candidate=getenv("PROFILE_APPLY_FIXTURE_DIR")+"/candidate";
fs.writefile(target,"original");fs.writefile(candidate,"candidate");
let digest=hash(target),activations=0,restores=0;
let hooks={validate:()=>true,capture:()=>({running:true,enabled:true}),activate:()=>{activations++;return true;},restore:()=>{restores++;return true;}};
hooks.validate=()=>false;
let rejected=t.apply(candidate,digest,"test",hooks);
assert(rejected.error=="candidate_check_failed" && fs.readfile(target)=="original","validation fails without replacement: "+sprintf("%J",rejected));
hooks.validate=()=>true;
let conflict=t.apply(candidate,"stale","test",hooks);
assert(conflict.error=="conflict","stale digest rejected: "+sprintf("%J",conflict));
assert(!activations,"no activation before validation");
hooks.validate=()=>{fs.writefile(target,"edited");return true;};
assert(t.apply(candidate,digest,"test",hooks).error=="conflict","recheck digest after validation");
assert(fs.readfile(target)=="edited","concurrent edit retained");
fs.writefile(target,"original");hooks.validate=()=>true;
hooks.activate=()=>false;
let failed=t.apply(candidate,digest,"test",hooks);
assert(!failed.success && failed.restored && restores==1 && fs.readfile(target)=="original","restart failure restores exact original");
hooks.restore=()=>false;
failed=t.apply(candidate,digest,"test",hooks);
assert(!failed.success && failed.rollback_error && fs.readfile(target)=="original","restore failure explicit");
assert(t.recover().success,"recover outstanding restoration journal");
hooks.restore=()=>true;hooks.activate=()=>true;
assert(t.apply(candidate,digest,"test",hooks).success && fs.readfile(target)=="candidate","successful replacement");
assert(fs.readfile(t.previous_path())=="original","previous original retained separately");
assert(!t.status().running,"successful transaction terminal");
fs.writefile(target,"original");hooks.capture=()=>({running:false,enabled:false});
hooks.activate=()=>{die("stopped service must not activate");};
assert(t.apply(candidate,digest,"test",hooks).success,"stopped service stays stopped");
print("transaction failure matrix passed\n");
