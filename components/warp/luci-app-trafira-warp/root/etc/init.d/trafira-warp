#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
USE_PROCD=1
START=96
STOP=04
start_service() {
    # OpenWrt invokes start after package replacement; only the coordinator may
    # resume a previously running service after its complete family is verified.
    [ "${PKG_UPGRADE:-0}" != 1 ] || return 0
    if [ -e /etc/trafira/warp-packages/journal.json ] && ! ucode -L /usr/lib/trafira /usr/lib/trafira/integrations/warp_cli.uc permit-start; then
        /usr/bin/trafira component_action warp recover >/dev/null
        return $?
    fi
    if [ -e /etc/trafira-warp/active.json ] && ! ucode -L /usr/lib/trafira /usr/lib/trafira/integrations/warp_cli.uc permit-start; then
        ucode -L /usr/lib/trafira -L /usr/lib/trafira-warp /usr/lib/trafira/integrations/warp_cli.uc recover >/dev/null
        return 0
    fi
    [ -s /etc/trafira-warp/transport.json ] || return 0
    [ "$(jsonfilter -i /etc/trafira-warp/transport.json -e '@.enabled')" = true ] || return 0
    if ! ucode -L /usr/lib/trafira /usr/lib/trafira/integrations/warp_cli.uc permit-start; then
        /usr/bin/trafira-config warp_action '{"action":"enable"}' >/dev/null
        return 0
    fi
    procd_open_instance tunnel
    procd_set_param command /usr/libexec/trafira-warp-awg-runner
    procd_set_param env GOMEMLIMIT=40MiB GOMAXPROCS=1 WG_PROCESS_FOREGROUND=1
    procd_set_param term_timeout 5
    procd_close_instance
    procd_open_instance watchdog
    procd_set_param command /usr/libexec/trafira-warp-watchdog
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 5
    procd_close_instance
}
