let format=require("config.profile_format");
let profiles=require("config.profiles");
let fs=require("fs");
let config=[{".name":"settings",".type":"settings",dns_server:["1.1.1.1"]},{".name":"proxy",".type":"section",enabled:"1",password:"secret",proxy_string:"vless://private@example.com"}];
let doc={schema:1,name:"Home",created_at:1,config};
assert(format.validate(doc).valid,"valid profile");
assert(!format.validate({schema:99,name:"A",config}).valid,"unknown schema");
assert(!format.validate({schema:1,name:"A",config:{network:[]}}).valid,"wrong shape");
assert(!format.validate({schema:1,name:"",config}).valid,"empty name");
assert(!format.name_valid("bad\x00name"),"NUL name rejected");
assert(!format.name_valid("bad\nname"),"control name rejected");
assert(!format.name_valid(sprintf("%065d",1)),"name length bound");
let russian="";for(let n=0;n<64;n++)russian+="я";
assert(format.name_valid(russian),"64 Cyrillic characters are a valid name");
assert(!format.name_valid(russian+"я"),"65 Cyrillic characters exceed the name limit");
assert(!format.validate({schema:1,name:"A",config:[{".name":"network",".type":"network"}]}).valid,"foreign UCI package");
let exported=format.to_uci(config);
assert(index(exported,"config settings 'settings'")>=0,"serialized section");
assert(index(exported,"list dns_server '1.1.1.1'")>=0,"serialized list");
let created=profiles.create(doc);
assert(created.success && created.id,"create");
assert(profiles.list().entries[0].name=="Home","list metadata");
assert(index(sprintf("%J",profiles.list()),"secret")<0,"list privacy");
let original=profiles.export_profile(created.id);
assert(original.success && original.document.config[1].password=="secret","explicit export preserves secret");
let preview=profiles.preview(created.id,[]);
assert(preview.success && index(sprintf("%J",preview),"secret")<0 && index(sprintf("%J",preview),"vless://")<0,"diff privacy");
assert(!profiles.export_profile("../config").success,"path traversal");
assert(profiles.rename(created.id,"Office").success,"rename");
assert(profiles.list().entries[0].name=="Office","renamed metadata");
for(let n=1;n<8;n++) assert(profiles.create({schema:1,name:"Profile "+n,created_at:1,config}).success,"create within limit");
assert(!profiles.create(doc).success,"ninth rejected");
assert(profiles.remove(created.id).success,"remove");
assert(!profiles.export_profile(created.id).success,"removed unavailable");
let rename_original=fs.rename;
fs.rename=(source,target)=>false;
let rejected=profiles.create(doc);
fs.rename=rename_original;
assert(!rejected.success && length(profiles.list().entries)==7,"rename failure does not publish a partial profile");
let open_original=fs.open;
fs.open=function(path,mode,permissions){
    let file=open_original(path,mode,permissions);
    if(file && substr(path,-6)==".stage")return {write:()=>0,flush:()=>false,close:()=>file.close()};
    return file;
};
rejected=profiles.create(doc);
fs.open=open_original;
assert(!rejected.success && length(profiles.list().entries)==7,"short write simulating full disk leaves profiles unchanged");
let foreign=profiles.DIRECTORY+"/../foreign";
fs.writefile(foreign,"unchanged");
fs.symlink(foreign,profiles.DIRECTORY+"/p-link.json");
assert(!profiles.export_profile("p-link").success && !profiles.rename("p-link","No").success,"profile symlinks rejected");
assert(fs.readfile(foreign)=="unchanged","symlink target untouched");
fs.unlink(profiles.DIRECTORY+"/p-link.json");
let long={schema:1,name:"Too big",config:[{".name":"settings",".type":"settings",data:sprintf("%01048577d",1)}]};
assert(!profiles.create(long).success,"oversized profile");
print("configuration profiles checks passed\n");
